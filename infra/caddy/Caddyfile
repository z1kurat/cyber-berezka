# Cyber Berezka — Caddy reverse proxy.
# Variables (from infra/.env, mapped by compose):
#   SITE_HOST            — main user-facing host (home.cyber-berezka.ru or nip.io)
#   ADMIN_HOST           — panel host (admin.cyber-berezka.ru or nip.io); also serves /api/sub
#   APEX_REDIRECT_HOST   — optional apex (cyber-berezka.ru) for 301 → SITE_HOST. Empty in Stage 1 (nip.io).
#   ADMIN_IP_WHITELIST   — space-separated CIDRs allowed to /admin/, /admin/*, /api/admin/*

{
    email {$ACME_EMAIL}
}

# === Site host (user-facing: landing + auth + cabinet + legal) ============
{$SITE_HOST} {
    @blocked_clients header User-Agent *Happ*
    handle @blocked_clients {
        respond "Client not supported. Use v2RayTun, Hiddify, or NekoBox." 403
    }

    handle {
        reverse_proxy * http://site:8000
    }

    encode gzip zstd
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

# === Admin host (panel + subscription endpoints) ===========================
# /api/sub/*           — public subscription URLs (clients must reach these)
# /admin, /admin/*     — Remnawave dashboard UI (IP-restricted)
# /api/admin/*         — Remnawave admin API (IP-restricted)
# anything else        — panel (REST API, OpenAPI docs etc.)
{$ADMIN_HOST} {
    @blocked_clients header User-Agent *Happ*
    handle @blocked_clients {
        respond "Client not supported." 403
    }

    handle /api/sub/* {
        reverse_proxy http://remnawave:3000
    }

    @admin_paths {
        path /admin /admin/* /api/admin/*
    }
    @admin_allowed {
        path /admin /admin/* /api/admin/*
        remote_ip {$ADMIN_IP_WHITELIST}
    }
    handle @admin_allowed {
        reverse_proxy http://remnawave:3000
    }
    handle @admin_paths {
        respond "403 Forbidden" 403
    }

    handle {
        reverse_proxy * http://remnawave:3000
    }

    encode gzip zstd
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

# === Apex redirect (only active when APEX_REDIRECT_HOST is set) ===========
# Caddy will accept the placeholder host but no real client can reach it,
# so the block is inert in Stage 1 (APEX_REDIRECT_HOST empty).
{$APEX_REDIRECT_HOST:placeholder.invalid} {
    redir https://{$SITE_HOST}{uri} 301
}

# === Catch-all (anti-fingerprint) =========================================
:443 {
    tls internal
    respond 204
}
