# Cyber Berezka — environment template.
# Copy to .env, fill in secrets (do NOT commit the real .env).
#
# Generate secrets:
#   openssl rand -hex 64    # for JWT_AUTH_SECRET, JWT_API_TOKENS_SECRET
#   openssl rand -hex 24    # for POSTGRES_PASSWORD
#   openssl rand -hex 16    # for WEBHOOK_SECRET_HEADER
#   openssl rand -hex 12    # for METRICS_PASS

# ─── DOMAINS ──────────────────────────────────────────────────────────
SITE_DOMAIN=cyber-berezka.tw1.ru          # apex: auth, cabinet, /api/sub, /legal
LANDING_DOMAIN=home.cyber-berezka.tw1.ru  # landing + admin path (/admin/*)
PANEL_DOMAIN=admin.194-87-83-31.nip.io    # legacy nip.io (keep during transition)
ACME_EMAIL=admin@example.com
ADMIN_IP_WHITELIST=127.0.0.1              # space-separated IPs allowed to /admin/*

# Subscription URL prefix. Remnawave hosts it at PANEL_DOMAIN/api/sub
# but a separate domain can be set later for cleaner UX.
SUB_PUBLIC_DOMAIN=admin.194-87-83-31.nip.io/api/sub
# CORS-allowed origin for the panel. Use the panel domain in production.
FRONT_END_DOMAIN=admin.194-87-83-31.nip.io

# ─── REMNAWAVE PANEL ──────────────────────────────────────────────────
APP_PORT=3000
METRICS_PORT=3001

# JWT secrets, minimum 64 chars. Replace BEFORE first run.
JWT_AUTH_SECRET=REPLACE_64_CHARS
JWT_API_TOKENS_SECRET=REPLACE_64_CHARS

# Metrics basic-auth credentials.
METRICS_USER=metrics
METRICS_PASS=REPLACE_ME

# Webhook secret (32+ chars, alphanumeric only).
WEBHOOK_ENABLED=false
WEBHOOK_SECRET_HEADER=REPLACE_ME_32_CHARS_ALPHANUMERIC

# Telegram notifications disabled in MVP.
IS_TELEGRAM_NOTIFICATIONS_ENABLED=false

# Operational defaults.
IS_DOCS_ENABLED=false
IS_HTTP_LOGGING_ENABLED=false
ENABLE_DEBUG_LOGS=false
JWT_AUTH_LIFETIME=24
SHORT_UUID_LENGTH=16

# ─── ПРИЛОЖЕНИЕ САЙТА (Cyber Berezka site) ────────────────────────────
APP_SECRET_KEY=GENERATE_WITH_openssl_rand_-hex_32
APP_DEBUG=false
SITE_PUBLIC_URL=https://cyber-berezka.tw1.ru
SESSION_LIFETIME_HOURS=720
PASSWORD_MIN_LENGTH=12
MAX_KEYS_PER_USER=3

# Site DB (отдельная от panel)
APP_DB_USER=app
APP_DB_PASSWORD=GENERATE_WITH_openssl_rand_-hex_24
APP_DB_NAME=cyber_berezka

# Brevo (transactional email — bootstrapping after Brevo account creation)
BREVO_API_KEY=PASTE_AFTER_BREVO_SIGNUP
BREVO_SENDER_EMAIL=noreply@cyber-berezka.tw1.ru
BREVO_SENDER_NAME=Cyber Berezka

# ─── REMNAWAVE NODE ───────────────────────────────────────────────────
# Port the node listens on for mTLS from the panel.
NODE_PORT=2222
# Base64-encoded JSON bundle (nodeCertPem/nodeKeyPem/caCertPem/jwtPublicKey)
# generated by the panel when the node entry is created. Copy from the
# 'Secret Key' field in the panel's node form.
NODE_SECRET_KEY=PASTE_FROM_PANEL_UI

# ─── VALKEY (REDIS-COMPATIBLE) ────────────────────────────────────────
# Valkey listens on a Unix socket only (--port 0 in compose). The path is
# shared between backend and valkey containers via the valkey-socket volume.
REDIS_SOCKET=/var/run/valkey/valkey.sock

# ─── POSTGRES (DEDICATED FOR REMNAWAVE) ───────────────────────────────
POSTGRES_USER=remnawave
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=remnawave
# Connection string passed to the backend container.
DATABASE_URL=postgresql://remnawave:REPLACE_ME@remnawave-db:5432/remnawave
